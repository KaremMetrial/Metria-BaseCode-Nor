APP_NAME=Metrial
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === Database ===
# DB_HOST/DB_PORT refer to the `db` service on the internal Docker network.
# DB_HOST_PORT is the port MySQL is published on to the host machine.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=metrial
DB_USERNAME=metrial
DB_PASSWORD=metrial
DB_HOST_PORT=3308

# === Sessions / Cache / Queue (all backed by Redis) ===
# SESSION_CONNECTION must name a connection from config/database.php
# (`default` or `cache`) -- it is NOT the driver.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=0

CACHE_STORE=redis
CACHE_PREFIX=metrial-cache-

MEMCACHED_HOST=127.0.0.1

# === Redis ===
# predis is used instead of the phpredis extension.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Prefix for Redis pub/sub channel names. The socketio service must be given
# the same value or its relay will subscribe to the wrong channels.
REDIS_PREFIX=metrial_
# Connection (from config/database.php) Laravel publishes broadcasts on.
REDIS_BROADCAST_CONNECTION=default

# === Socket.IO ===
SOCKET_IO_HOST=socketio
SOCKET_IO_PORT=6001
SOCKET_IO_HOST_PORT=6001

# === CORS ===
CORS_ORIGIN=http://localhost:3000,http://localhost

# === Access control / abuse limits (requests per minute) ===
RATE_LIMIT_API=60
RATE_LIMIT_WEBHOOKS=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_OTP_REQUEST=3
RATE_LIMIT_OTP_VERIFY=5

# === Development administrator ===
# Seeded by DatabaseSeeder outside production only. Never ship these values.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=password

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Provider selection: disabled until credentials are configured.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PAYMENT_PROVIDER=disabled
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=true
SOCKET_TOKEN_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_HOURLY_LIMIT=6
OTP_MOBILE_ONLY=true
AUTH_TOKEN_MINUTES=1440

# Optional notification channels, disabled until commissioned.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_FCM_ENABLED=false
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
